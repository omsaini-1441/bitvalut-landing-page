# Copy to `.env` and optionally `.env.local`, then `npm run dev`.
# Values are preloaded into the process so PORT binds correctly (Next alone
# loads .env too late for the listen port).

PORT=3001

# Must match PORT in local/dev (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose these through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
APK_DOWNLOAD_URL=https://github.com/omsaini-1441/bitvalut-landing-page/releases

# Base64-encoded 32-byte key. Generate once and keep it stable:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RECOVERY_KEY_KEK=
