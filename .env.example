# Copy to `.env.local` and adjust. Next.js loads these automatically.

# Dev / production server port (`next dev` and `next start`)
PORT=3001

# Public site origin (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Primary CTA — GitHub releases / APK download
NEXT_PUBLIC_APK_URL=https://github.com/omsaini-1441/bitvalut-landing-page/releases

# --- Future dashboard / API (server-only; never NEXT_PUBLIC_ unless it must ship to the browser) ---
# DASHBOARD_API_URL=http://localhost:4000
# DATABASE_URL=
# AUTH_SECRET=
# AUTH_URL=http://localhost:3001
